#!/usr/bin/env bash

# One-command setup and launcher for ShowAndTell-Bench.

set -euo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
venv_dir="$repo_root/.venv"
venv_python="$venv_dir/bin/python"
venv_cli="$venv_dir/bin/showAndTell"

usage() {
  cat <<'EOF'
Usage:
  ./showAndTell setup       Create/update .venv and install all dependencies
  ./showAndTell viewer [PORT]  Start the task viewer (default: port 8000)
  ./showAndTell dataset-pull   Download the latest published task dataset
  ./showAndTell <COMMAND> ...  Run an installed ShowAndTell CLI command
  ./showAndTell help           Show this help

Running ./showAndTell without a command also starts the viewer.
EOF
}

python_is_supported() {
  "$1" -c 'import sys; raise SystemExit(sys.version_info < (3, 12))' \
    >/dev/null 2>&1
}

find_setup_python() {
  local candidate minor

  if command -v python3 >/dev/null 2>&1 && python_is_supported python3; then
    command -v python3
    return 0
  fi

  # A system python3 may be old even when a versioned modern Python exists.
  for minor in {20..12}; do
    candidate="python3.$minor"
    if command -v "$candidate" >/dev/null 2>&1 \
        && python_is_supported "$candidate"; then
      command -v "$candidate"
      return 0
    fi
  done

  if command -v python >/dev/null 2>&1 && python_is_supported python; then
    command -v python
    return 0
  fi

  return 1
}

print_python_install_hint() {
  printf 'Python 3.12 or newer is required but was not found.\n' >&2

  case "$(uname -s)" in
    Darwin)
      if command -v brew >/dev/null 2>&1; then
        printf '%s\n' \
          'Install it with Homebrew:' \
          '  brew install python@3.12' >&2
      else
        printf '%s\n' \
          'Install Homebrew from https://brew.sh, then run:' \
          '  brew install python@3.12' >&2
      fi
      ;;
    Linux)
      if command -v apt-get >/dev/null 2>&1; then
        printf '%s\n' \
          'Install it with apt:' \
          '  sudo apt-get update' \
          '  sudo apt-get install python3.12 python3.12-venv' >&2
      elif command -v dnf >/dev/null 2>&1; then
        printf '%s\n' \
          'Install it with dnf:' \
          '  sudo dnf install python3.12' >&2
      elif command -v pacman >/dev/null 2>&1; then
        printf '%s\n' \
          'Install it with pacman:' \
          '  sudo pacman -S python' >&2
      else
        printf 'Install it from https://www.python.org/downloads/\n' >&2
      fi
      ;;
    *)
      printf 'Install it from https://www.python.org/downloads/\n' >&2
      ;;
  esac

  printf 'Then run: ./showAndTell setup\n' >&2
}

print_docker_install_hint() {
  case "$(uname -s)" in
    Darwin)
      if command -v brew >/dev/null 2>&1; then
        printf '%s\n' \
          'Install Docker Desktop when you want to run tasks:' \
          '  brew install --cask docker' \
          '  open -a Docker' >&2
      else
        printf '%s\n' \
          'Install and start Docker Desktop:' \
          '  https://docs.docker.com/desktop/setup/install/mac-install/' >&2
      fi
      ;;
    Linux)
      printf '%s\n' \
        'Install Docker Engine with the Compose plugin:' \
        '  https://docs.docker.com/engine/install/' >&2
      ;;
    *)
      printf '%s\n' \
        'Install and start Docker Desktop:' \
        '  https://docs.docker.com/desktop/' >&2
      ;;
  esac
}

check_docker() {
  printf '\nChecking optional task-runner prerequisites...\n'
  if ! command -v docker >/dev/null 2>&1; then
    printf '%s\n' \
      'WARNING: Docker was not found. The viewer will work, but Run and New task will not.' >&2
    print_docker_install_hint
    return 0
  fi
  if ! docker compose version >/dev/null 2>&1; then
    printf '%s\n' \
      'WARNING: Docker Compose v2 is unavailable. Run and New task require `docker compose`.' >&2
    print_docker_install_hint
    return 0
  fi
  if ! docker info >/dev/null 2>&1; then
    printf '%s\n' \
      'WARNING: Docker is installed but its daemon is not running.' \
      'Start Docker Desktop (or Docker Engine) before using Run or New task.' >&2
    return 0
  fi
  printf 'Docker and Docker Compose are ready.\n'
}

install_native_runtime_dependencies() {
  case "$(uname -s)" in
    Darwin)
      if ! command -v brew >/dev/null 2>&1; then
        printf '%s\n' \
          'Homebrew is required for the macOS recording runtime.' \
          'Install it from https://brew.sh, then run ./showAndTell setup again.' >&2
        return 1
      fi
      printf '\nInstalling native recording requirements from Brewfile...\n'
      # VB-CABLE is installed as a standard signed package. Homebrew may ask
      # once for an administrator password; no Audio MIDI configuration is
      # needed because ShowAndTell selects both sides of the cable itself.
      brew bundle --file="$repo_root/Brewfile"
      ;;
    Linux)
      local missing=()
      command -v ffmpeg >/dev/null 2>&1 || missing+=(ffmpeg)
      command -v pactl >/dev/null 2>&1 || missing+=(pulseaudio-utils)
      command -v espeak-ng >/dev/null 2>&1 || missing+=(espeak-ng)
      if (( ${#missing[@]} )); then
        printf '%s\n' \
          "WARNING: native recording requirements are missing: ${missing[*]}" \
          'On Debian/Ubuntu install them with:' \
          "  sudo apt-get install ${missing[*]}" >&2
      fi
      ;;
  esac
}

collect_native_dependency_plan() {
  native_dependency_plan=''
  [[ "$(uname -s)" == Darwin ]] || return 0

  local details install_path kind package purpose size status version
  while IFS='|' read -r kind package; do
    if [[ "$kind" == brew ]]; then
      if details="$(brew list --formula --versions "$package" 2>/dev/null)"; then
        status='Already installed'
        version="${details#"$package "}"
        install_path="$(brew --cellar "$package")"
      else
        status='Will install'
        version='latest'
        install_path=''
      fi
    else
      if details="$(brew list --cask --versions "$package" 2>/dev/null)"; then
        status='Already installed'
        version="${details#"$package "}"
        install_path="$(brew --caskroom)/$package"
      else
        status='Will install'
        version='latest'
        install_path=''
      fi
    fi
    case "$package" in
      ffmpeg)
        purpose='Plays and processes recorded narration audio'
        size='~52 MB'
        ;;
      switchaudio-osx)
        purpose='Selects and restores macOS audio devices'
        size='<1 MB'
        ;;
      vb-cable)
        purpose='Routes narration through a virtual audio device'
        size='~2 MB'
        ;;
      *)
        purpose='Required by the native recording runtime'
        size='Unknown'
        ;;
    esac
    if [[ -n "$install_path" && -d "$install_path" ]]; then
      size="$(du -sh "$install_path" 2>/dev/null | awk '{print $1}')"
    fi
    native_dependency_plan+="$package|$version|$status|$size|$purpose"$'\n'
  done < <(sed -nE \
    's/^[[:space:]]*(brew|cask)[[:space:]]+"([^"]+)".*/\1|\2/p' \
    "$repo_root/Brewfile")
}

measure_setup_sizes() {
  local dataset_cache_root dataset_check dataset_json dataset_repo dataset_revision
  local dataset_url playwright_check playwright_locations size_python
  local python_package_check

  python_packages_size='Not installed'
  python_packages_status='Will install'
  if [[ -x "$venv_python" ]]; then
    python_packages_size="$($venv_python - <<'PY'
import sysconfig
from pathlib import Path

root = Path(sysconfig.get_paths()["purelib"])
size = sum(path.stat().st_size for path in root.rglob("*") if path.is_file())
print(f"{size / 1_048_576:.1f} MiB")
PY
)"
    python_package_check="$(
      "$venv_python" - "$repo_root" 2>/dev/null <<'PY' || true
import sys
import tomllib
from importlib import metadata
from pathlib import Path

root = Path(sys.argv[1])
project = tomllib.loads((root / "pyproject.toml").read_text("utf-8"))["project"]
declared = list(project["dependencies"])
declared += [
    line.strip()
    for line in (root / "requirements.txt").read_text("utf-8").splitlines()
    if line.strip() and not line.lstrip().startswith(("#", "-"))
]
try:
    from packaging.requirements import Requirement
except ImportError:
    print("Will install")
    raise SystemExit

missing = []
outdated = []
for text in declared:
    requirement = Requirement(text)
    if requirement.marker and not requirement.marker.evaluate():
        continue
    try:
        version = metadata.version(requirement.name)
    except metadata.PackageNotFoundError:
        missing.append(requirement.name)
        continue
    if requirement.specifier and version not in requirement.specifier:
        outdated.append(f"{requirement.name} {version}")
try:
    metadata.version(project["name"])
except metadata.PackageNotFoundError:
    missing.append(project["name"])
try:
    metadata.version("pip")
except metadata.PackageNotFoundError:
    missing.append("pip")

if missing:
    print("Will install")
elif outdated:
    print("Will update")
else:
    print("Already satisfied")
PY
)"
    if [[ -n "$python_package_check" ]]; then
      python_packages_status="$python_package_check"
    fi
  fi

  playwright_status='Will install'
  playwright_version='From Playwright'
  playwright_size='~510 MB'
  if [[ -x "$venv_python" ]] \
      && playwright_check="$($venv_python -m playwright install --dry-run chromium 2>/dev/null)"; then
    playwright_version="$(printf '%s\n' "$playwright_check" | sed -nE \
      '1s/.*\(playwright chromium (v[0-9]+)\).*/Chromium \1/p')"
    [[ -n "$playwright_version" ]] || playwright_version='Playwright managed'
    playwright_locations="$(printf '%s\n' "$playwright_check" \
      | sed -n 's/^[[:space:]]*Install location:[[:space:]]*//p')"
    playwright_status='Already installed'
    while IFS= read -r install_path; do
      if [[ -n "$install_path" && ! -d "$install_path" ]]; then
        playwright_status='Will install'
      fi
    done <<< "$playwright_locations"
  fi

  dataset_repo="${SHOWANDTELL_DATASET_REPO:-brackettai/showtellarena}"
  dataset_revision="${SHOWANDTELL_DATASET_REVISION:-}"
  if [[ -x "$venv_python" ]]; then
    size_python="$venv_python"
  else
    size_python="$setup_python"
  fi
  dataset_url="$($size_python -c \
    'import sys, urllib.parse; repo, revision = sys.argv[1:]; print(f"https://huggingface.co/api/datasets/{repo}" + ("/revision/" + urllib.parse.quote(revision, safe="") if revision else "") + "?blobs=true")' \
    "$dataset_repo" "$dataset_revision")"
  dataset_size=''
  dataset_status='Cannot determine'
  dataset_version='Hugging Face'
  if [[ -n "${HUGGINGFACE_HUB_CACHE:-}" ]]; then
    dataset_cache_root="$HUGGINGFACE_HUB_CACHE"
  elif [[ -n "${HF_HOME:-}" ]]; then
    dataset_cache_root="$HF_HOME/hub"
  else
    dataset_cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/huggingface/hub"
  fi
  if command -v curl >/dev/null 2>&1; then
    dataset_json="$(curl -Lsf --max-time 10 "$dataset_url" || true)"
    dataset_check="$(printf '%s' "$dataset_json" | $size_python -c '
import json
import sys
from pathlib import Path

cache_root, repo = sys.argv[1:]
info = json.load(sys.stdin)
files = [
    item for item in info.get("siblings", ())
    if item.get("rfilename") == "tasks.jsonl"
    or item.get("rfilename", "").startswith("tasks/")
]
revision = info.get("sha", "")
snapshot = Path(cache_root) / ("datasets--" + repo.replace("/", "--")) / "snapshots" / revision
missing = [item for item in files if not (snapshot / item["rfilename"]).exists()]
total_size = sum(item.get("size") or 0 for item in files)
print(f"{total_size / 1_048_576:.1f} MiB|{revision[:12]}|{len(missing)}")
' "$dataset_cache_root" "$dataset_repo" 2>/dev/null || true)"
    if [[ -n "$dataset_check" ]]; then
      local dataset_missing
      IFS='|' read -r dataset_size dataset_version dataset_missing \
        <<< "$dataset_check"
      dataset_version="HF $dataset_version"
      if [[ "$dataset_missing" == 0 ]]; then
        dataset_status='Already current'
      else
        dataset_status='Will download'
      fi
    fi
  fi
  [[ -n "$dataset_size" ]] || dataset_size='Unavailable'
}

print_setup_table_border() {
  printf '%s\n' \
    '+----------------------+--------------------+-------------------+--------------+----------------------------------------------------+'
}

print_setup_table_row() {
  printf '| %-20s | %-18s | %-17s | %-12s | %-50s |\n' \
    "$1" "$2" "$3" "$4" "$5"
}

print_setup_plan() {
  local item name purpose size status version venv_size venv_status venv_version

  if [[ -x "$venv_python" ]]; then
    venv_status='Already created'
    venv_version="$($venv_python -c 'import platform; print(platform.python_version())')"
    venv_size="$(du -sh "$venv_dir" 2>/dev/null | awk '{print $1}')"
  else
    venv_status='Will create'
    venv_version="$($setup_python -c 'import platform; print(platform.python_version())')"
    venv_size='~250 MB'
  fi

  printf '%s\n' 'Setup components:'
  print_setup_table_border
  print_setup_table_row 'Name' 'Version/source' 'Status' 'Approx. size' 'Why needed'
  print_setup_table_border
  if [[ -n "$native_dependency_plan" ]]; then
    while IFS= read -r item; do
      if [[ -n "$item" ]]; then
        IFS='|' read -r name version status size purpose <<< "$item"
        print_setup_table_row "$name" "$version (brew)" "$status" "$size" "$purpose"
      fi
    done <<< "$native_dependency_plan"
  fi
  print_setup_table_row 'Python environment' "$venv_version" "$venv_status" "$venv_size" \
    'Isolates ShowAndTell from system Python'
  print_setup_table_row 'Python packages' 'requirements.txt' "$python_packages_status" "$python_packages_size" \
    'Runs ShowAndTell and its development tools'
  print_setup_table_row 'Playwright Chromium' "$playwright_version" "$playwright_status" "$playwright_size" \
    'Drives browser-based demonstrations and tasks'
  print_setup_table_row 'Published dataset' "$dataset_version" "$dataset_status" "$dataset_size" \
    'Provides the published task bundles'
  if [[ ! -d "${SHOWANDTELL_CHROME_PROFILE:-$HOME/.showAndTell/chrome-profile}/Default" ]]; then
    print_setup_table_row 'Chrome profile' 'Local' 'Will create' '<1 MB initially' \
      'Keeps automation separate from personal browsing'
  fi
  print_setup_table_border
  printf '%s\n' \
    '* Sizes are approximate and may vary slightly.' \
    '' \
    'No changes have been made yet.'
}

confirm_setup_plan() {
  local reply

  printf 'Continue with setup? [y/N] '
  if ! IFS= read -r reply; then
    printf '\nSetup cancelled; nothing was installed.\n'
    return 1
  fi
  case "$reply" in
    y|Y|yes|YES|Yes) return 0 ;;
    *)
      printf 'Setup cancelled; nothing was installed.\n'
      return 1
      ;;
  esac
}

check_audio_runtime() {
  [[ "$(uname -s)" == Darwin ]] || return 0
  local missing=()
  command -v ffplay >/dev/null 2>&1 || missing+=(ffplay)
  command -v SwitchAudioSource >/dev/null 2>&1 || missing+=(SwitchAudioSource)
  if ! command -v SwitchAudioSource >/dev/null 2>&1 \
      || ! SwitchAudioSource -a -t output 2>/dev/null \
        | grep -Eiq '^VB(-Audio)?([ -]Virtual)?[ -]?CABLE$' \
      || ! SwitchAudioSource -a -t input 2>/dev/null \
        | grep -Eiq '^VB(-Audio)?([ -]Virtual)?[ -]?CABLE$'; then
    missing+=("VB-CABLE")
  fi
  if (( ${#missing[@]} )); then
    printf '%s\n' \
      "WARNING: audio runtime is not active: ${missing[*]}" \
      'If VB-CABLE was just installed, rerun ./showAndTell setup to verify it.' >&2
    return 0
  fi
  printf 'Recorded-narration audio runtime is ready.\n'
}

ensure_managed_chrome_profile() {
  local profile_root="${SHOWANDTELL_CHROME_PROFILE:-$HOME/.showAndTell/chrome-profile}"

  if [[ ! -d "$profile_root/Default" ]]; then
    mkdir -p "$profile_root/Default"
    printf 'Created an empty managed Chrome profile at %s.\n' "$profile_root"
    return 0
  fi
  printf 'Managed Chrome profile exists at %s.\n' "$profile_root"
}

require_environment() {
  if [[ ! -x "$venv_python" ]]; then
    printf 'ShowAndTell-Bench is not set up yet. Run: ./showAndTell setup\n' >&2
    exit 1
  fi
  if ! python_is_supported "$venv_python"; then
    printf '.venv uses an unsupported Python. Recreate it with Python 3.12+.\n' >&2
    exit 1
  fi
  if ! "$venv_python" -c 'import showAndTell, httpx, playwright' >/dev/null 2>&1; then
    printf 'The environment is incomplete. Run: ./showAndTell setup\n' >&2
    exit 1
  fi
  if [[ ! -x "$venv_cli" ]]; then
    printf 'The ShowAndTell CLI is missing. Run: ./showAndTell setup\n' >&2
    exit 1
  fi
}

setup() {
  local setup_python

  if [[ -x "$venv_python" ]]; then
    if ! python_is_supported "$venv_python"; then
      printf '%s\n' \
        'Existing .venv uses Python older than 3.12.' \
        'Move or remove .venv before running setup again.' >&2
      print_python_install_hint
      exit 1
    fi
  else
    if ! setup_python="$(find_setup_python)"; then
      print_python_install_hint
      exit 1
    fi
  fi

  if [[ "$(uname -s)" == Darwin ]] \
      && ! command -v brew >/dev/null 2>&1; then
    printf '%s\n' \
      'Homebrew is required for the macOS recording runtime.' \
      'Install it from https://brew.sh, then run ./showAndTell setup again.' >&2
    exit 1
  fi

  collect_native_dependency_plan
  measure_setup_sizes
  print_setup_plan
  confirm_setup_plan || return 0

  if [[ ! -x "$venv_python" ]]; then
    printf 'Creating %s with %s...\n' "$venv_dir" "$setup_python"
    "$setup_python" -m venv "$venv_dir"
  fi

  cd "$repo_root"
  install_native_runtime_dependencies
  if ! "$venv_python" -m pip --version >/dev/null 2>&1; then
    "$venv_python" -m ensurepip --upgrade
  fi
  if [[ "$python_packages_status" == 'Already satisfied' ]]; then
    printf '\nPython package requirements are already satisfied.\n'
  else
    "$venv_python" -m pip install -r requirements.txt
  fi
  if [[ "$playwright_status" == 'Already installed' ]]; then
    printf 'The required Playwright Chromium build is already installed.\n'
  else
    "$venv_python" -m playwright install chromium
  fi

  if [[ "$dataset_status" == 'Already current' ]]; then
    printf 'The published task dataset is already current.\n'
  else
    printf '\nFetching the published task dataset...\n'
    "$venv_cli" dataset-pull || printf '%s\n' \
      'WARNING: could not fetch the task dataset (offline?). Run ./showAndTell dataset-pull later.' >&2
  fi
  check_audio_runtime
  check_docker
  ensure_managed_chrome_profile

  printf '\nSetup complete. Start the viewer with: ./showAndTell viewer\n'
}

command_name="${1:-viewer}"
if (( $# > 0 )); then
  shift
fi

case "$command_name" in
  setup)
    if (( $# > 0 )); then
      printf 'The setup command does not accept options.\n\n' >&2
      usage >&2
      exit 2
    fi
    setup
    ;;
  viewer)
    if (( $# > 1 )); then
      printf 'The viewer command accepts at most one port.\n\n' >&2
      usage >&2
      exit 2
    fi
    require_environment
    cd "$repo_root"
    exec "$venv_python" -m showAndTell.viewer.serve "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    require_environment
    cd "$repo_root"
    exec "$venv_cli" "$command_name" "$@"
    ;;
esac
